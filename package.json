{
  "name": "maretol-base",
  "version": "1.0.0",
  "description": "maretol-baseのworkspaceのroot",
  "main": "index.js",
  "scripts": {
    "dev": "bash dev.sh",
    "dev:admin": "npm run --workspace=admin-pages run-dev",
    "next-dev:admin": "npm run --workspace=admin-pages dev",
    "build:admin": "npm run --workspace=admin-pages admin:build",
    "deploy:admin": "npm run --workspace=admin-pages deploy-prd",
    "deploy-stg:admin": "npm run --workspace=admin-pages deploy-stg",
    "dev:ogp": "npm run --workspace=ogp-data-fetcher dev",
    "dev:cms": "npm run --workspace=cms-data-fetcher dev",
    "dev:sns": "npm run --workspace=sns-article-publisher dev",
    "deploy:ogp": "npm run --workspace=ogp-data-fetcher deploy-prd",
    "deploy:cms": "npm run --workspace=cms-data-fetcher deploy-prd",
    "deploy:sns": "npm run --workspace=sns-article-publisher deploy-prd",
    "dev:astro": "npm run --workspace=pages-astro dev",
    "check:astro": "npm run --workspace=pages-astro check",
    "build:astro": "npm run --workspace=pages-astro build",
    "build-stg:astro": "npm run --workspace=pages-astro build-stg",
    "deploy-stg:astro": "npm run --workspace=pages-astro deploy-stg",
    "deploy:astro": "npm run --workspace=pages-astro deploy-prd",
    "test:cms": "npm run --workspace=cms-data-fetcher test",
    "test:md": "npm run --workspace=md-converter test",
    "test:ogp": "npm run --workspace=ogp-data-fetcher test",
    "test:sns": "npm run --workspace=sns-article-publisher test",
    "test:e2e": "npm run --workspace=e2e test:e2e"
  },
  "author": "maretol",
  "private": true,
  "workspaces": [
    "pages-astro",
    "admin-pages",
    "cms-data-fetcher",
    "cms-db",
    "ogp-data-fetcher",
    "packages/*",
    "sns-article-publisher",
    "e2e"
  ],
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
