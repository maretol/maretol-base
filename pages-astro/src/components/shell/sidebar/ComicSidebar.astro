---
import type { bandeDessineeResult } from 'api-types'
import SidebarFrame from './SidebarFrame.astro'
import CdnImage from '@/components/ui/CdnImage.astro'
import { buttonVariants } from '@/components/ui/button'
import { getComicCoverURL } from '@/lib/comic'
import { convertJST } from '@/lib/time'
import { cn } from '@/lib/utils'

type Props = { bandeDessinees: bandeDessineeResult[] }

const { bandeDessinees } = Astro.props
---

<SidebarFrame title="Comics">
  <div class="p-2">
    {
      bandeDessinees.map((comic) => (
        <div class="mb-4 relative w-full">
          <a href={`/comics/${comic.id}`} class="hover:underline">
            <div class="bg-gray-200 p-4">
              <CdnImage
                src={getComicCoverURL(comic)}
                width={100}
                height={200}
                quality={75}
                class="w-full h-auto object-contain"
                alt={comic.title_name}
              />
            </div>
            <div class="bg-gray-800/60 absolute bottom-0 w-full p-1">
              <p class="text-gray-200 font-semibold">{comic.title_name}</p>
              <p class="text-gray-300">{convertJST(comic.publishedAt)}</p>
            </div>
          </a>
        </div>
      ))
    }
    <a href="/comics" class:list={[cn(buttonVariants({ variant: 'secondary' }), 'w-full mt-2'), 'text-gray-500']}>
      <p class="font-bold">See latest comics</p>
    </a>
  </div>
</SidebarFrame>
