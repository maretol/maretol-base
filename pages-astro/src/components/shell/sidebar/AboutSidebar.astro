---
import SidebarFrame from './SidebarFrame.astro'
import SidebarLine from './SidebarLine.astro'

// rawText が無いのは、固定文言を取得できなかったとき
type Props = { rawText?: string }

const { rawText } = Astro.props
const lines = rawText?.split('\n') ?? []
---

<SidebarFrame title="About" error={rawText === undefined}>
  <div>
    {lines.map((line) => (line === '' ? <br /> : <SidebarLine text={line} />))}
  </div>
</SidebarFrame>
