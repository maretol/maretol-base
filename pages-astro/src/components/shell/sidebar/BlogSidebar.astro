---
import AboutSidebar from './AboutSidebar.astro'
import ArticlesSidebar from './ArticlesSidebar.astro'
import ComicSidebar from './ComicSidebar.astro'
import IllustSidebar from './IllustSidebar.astro'
import ProfileSidebar from './ProfileSidebar.astro'
import TagSidebar from './TagSidebar.astro'
import { getAteliers, getBandeDessinees, getLatestCMSContents, getStatic, getTags } from '@/lib/api/cms'
import { assertSidebarTagged } from '@/lib/cache'
import { markDegraded } from '@/lib/degraded'

// サイドバー。固定文言と、最新の漫画・イラスト・記事、タグの一覧を出す。
// 表示する一覧のタグは、ページが cachePage() に { sidebar: true } を渡して付ける。付け忘れはここで例外にする
assertSidebarTagged(Astro.response)

// 最新の一覧に出す件数
const LATEST_COUNT = 5

// 取得できなかった区画は、枠の中に取得できなかったことを出し、不完全なページとして記録する（本文は表示する）
async function fetchSection<T>(name: string, fetcher: () => Promise<T>): Promise<T | null> {
  try {
    return await fetcher()
  } catch (e) {
    console.error(`[components/shell/sidebar/BlogSidebar.astro] ${name} fetch error:`, e)
    markDegraded(Astro.locals, `sidebar: ${name}`)
    return null
  }
}

const [staticData, comics, ateliers, articles, tags] = await Promise.all([
  fetchSection('static', getStatic),
  fetchSection('comics', () => getBandeDessinees(0, LATEST_COUNT)),
  fetchSection('illusts', () => getAteliers(0, LATEST_COUNT)),
  fetchSection('articles', () => getLatestCMSContents(Astro.locals, LATEST_COUNT)),
  fetchSection('tags', () => getTags(Astro.locals)),
])
---

<div class="w-full h-full gap-4 flex flex-col">
  {/* 固定文言は、取得できても該当する項目が無いことがある（その場合も取得できなかった表示にする） */}
  <AboutSidebar rawText={staticData?.sidebar_about} />
  <ProfileSidebar rawText={staticData?.sidebar_profile} />
  <ComicSidebar bandeDessinees={comics?.bandeDessinees ?? null} />
  <IllustSidebar ateliers={ateliers?.ateliers ?? null} />
  <ArticlesSidebar articles={articles} />
  <TagSidebar tags={tags} />
</div>
