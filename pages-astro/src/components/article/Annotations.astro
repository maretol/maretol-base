---
import type { Annotation } from 'api-types'

type Props = { annotations: Annotation[] }

const { annotations } = Astro.props
---

{
  annotations.length > 0 && (
    <div class="mt-8 pt-4 border-t border-gray-300">
      <ol class="list-none pl-0">
        {annotations.map((annotation) => (
          <li id={`annotation-${annotation.number}`} class="text-sm text-gray-600 mb-1 list-none">
            <span class="font-semibold mr-1">[{annotation.number}]</span>
            {annotation.text}
            <a
              href={`#annotation-ref-${annotation.number}`}
              class="ml-1 text-gray-400 hover:text-gray-600 no-underline"
              aria-label="注釈参照へ戻る"
              title="注釈参照へ戻る"
            >
              ↩
            </a>
          </li>
        ))}
      </ol>
    </div>
  )
}
