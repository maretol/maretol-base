---
import { LockIcon } from '@lucide/astro'
import SecretGateForm from '@/components/islands/SecretGateForm'
import { buttonVariants } from '@/components/ui/button'
import { withDraftKey } from '@/lib/draft'
import { cn } from '@/lib/utils'

// 限定公開記事の、解錠する前の表示。題名と、閲覧コードの入力フォームだけを出す（本文は出さない）
type Props = { articleID: string; title: string; draftKey?: string }

const { articleID, title, draftKey } = Astro.props
const action = withDraftKey(`/blog/${articleID}/unlock`, draftKey)

// 入力欄の class（現行サイトの shadcn/ui の Input に、このフォームの指定を重ねたもの）
const inputClassName = cn(
  'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm',
  'w-full rounded-md border border-gray-300 px-3 py-2 pr-10 focus:border-gray-500 focus:outline-none',
)
const buttonClassName = cn(buttonVariants(), 'w-full gap-1 font-suse')
---

<div class="flex flex-col items-center gap-6 rounded-md bg-gray-100 px-6 py-12">
  <div class="flex flex-col items-center gap-2 text-center">
    <LockIcon class="h-8 w-8 text-gray-500" />
    <h1 class="text-xl font-bold font-suse">{title}</h1>
    <p class="text-sm text-gray-600">この記事は限定公開です。閲覧コードを入力してください。</p>
  </div>
  <SecretGateForm client:load action={action} inputClassName={inputClassName} buttonClassName={buttonClassName} />
</div>
