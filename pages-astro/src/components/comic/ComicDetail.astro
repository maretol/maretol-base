---
import type { bandeDessineeResult } from 'api-types'
import { BookImageIcon, HouseIcon, SquareArrowLeftIcon, SquareArrowRightIcon, SquareArrowUpIcon } from '@lucide/astro'
import ComicNavButton from './ComicNavButton.astro'
import Annotations from '@/components/article/Annotations.astro'
import ArticleContent from '@/components/article/ArticleContent.astro'
import ShareSection from '@/components/article/ShareSection.astro'
import { buttonVariants } from '@/components/ui/button'
import { card } from '@/components/ui/card'
import { comicPath, comicSeriesPath } from '@/lib/comic'
import { getHostname } from '@/lib/site'
import { convertJST, convertJSTDate } from '@/lib/time'
import { cn } from '@/lib/utils'

// 漫画の詳細（ビューワの下に出す作品情報と説明文）
type Props = { comic: bandeDessineeResult; draftKey?: string }

const { comic, draftKey } = Astro.props
const url = `${getHostname()}${comicPath(comic.id)}`
// next_id / previous_id は配信側で公開済みの巻に限られている
const nextLink = comic.next_id ? comicPath(comic.next_id) : null
const previousLink = comic.previous_id ? comicPath(comic.previous_id) : null
const seriesLink = comic.series ? comicSeriesPath(comic.series.id) : null
const publishDate = comic.publish_date ? convertJSTDate(comic.publish_date) : '-'
const linkButtonClassName = cn(buttonVariants(), 'w-48 gap-1 font-suse')
---

<div class={cn(card.root, 'w-full bg-gray-100')}>
  <div class={cn(card.content, 'py-2')}>
    <div class="mt-5 space-y-2">
      <h1 class="text-2xl font-bold pl-2 pb-1 content-h2">{comic.title_name}</h1>
      <div class="flex items-center justify-end gap-2">
        <ShareSection shareURL={url} shareTitle={comic.title_name} contentType="comics" />
      </div>
      <div class="w-full font-semibold flex justify-center items-center gap-10">
        <ComicNavButton href={nextLink}>
          <SquareArrowLeftIcon class="w-4 h-4" />
          Next episode
        </ComicNavButton>
        <ComicNavButton href={previousLink}>
          Previous episode
          <SquareArrowRightIcon class="w-4 h-4" />
        </ComicNavButton>
      </div>
      <div class="w-full font-semibold flex justify-center items-center gap-10">
        <ComicNavButton href={seriesLink}>
          <SquareArrowUpIcon class="w-4 h-4" />
          This series
        </ComicNavButton>
      </div>
    </div>
  </div>
  <div class={cn(card.content, 'my-1 space-y-3')}>
    <h2 class="text-xl font-bold pb-1 border-blue-900 pl-3 border-l-4">作品詳細</h2>
    <div class="space-y-4 font-semibold">
      <div>
        <p>タイトル : {comic.title_name}</p>
        <p>シリーズ : {comic.series?.series_name || '-'}</p>
        <p>ジャンル : {comic.tag.tag_name || '-'}</p>
      </div>
      <div>
        <p>作成日 : {convertJST(comic.publishedAt)}</p>
        <p>最終更新日 : {convertJST(comic.updatedAt)}</p>
      </div>
      <div>
        <p>初公開イベント名 : {comic.publish_event || '-'}</p>
        <p>初公開イベント日 : {publishDate}</p>
      </div>
    </div>
    <div class="space-x-4 flex justify-center">
      <a href="/comics" class={linkButtonClassName}>
        <BookImageIcon class="w-4 h-4" />
        Comics Page Top
      </a>
      <a href="/" class={linkButtonClassName}>
        <HouseIcon class="w-4 h-4" />
        Page Home
      </a>
    </div>
  </div>
  <hr class="border-gray-600 mx-4 h-8" />
  <div class={card.content}>
    <ArticleContent
      contents={comic.parsed_description}
      tableOfContents={comic.table_of_contents}
      articleID={comic.id}
      draftKey={draftKey}
    />
    <Annotations annotations={comic.annotations ?? []} />
  </div>
</div>
