---
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'

// 漫画の詳細の「次の話」「前の話」「このシリーズ」のボタン。リンク先が無いときは無効なボタンとして出す
type Props = { href: string | null }

const { href } = Astro.props
const className = cn(buttonVariants({ variant: 'secondary' }), 'w-80 gap-1 font-suse')
---

{
  href ? (
    <a href={href} class={className}>
      <slot />
    </a>
  ) : (
    <button type="button" disabled class={className}>
      <slot />
    </button>
  )
}
