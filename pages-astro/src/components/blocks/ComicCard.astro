---
import type { bandeDessineeResult } from 'api-types'
import { cardNotFound } from './card_not_found'
import CdnImage from '@/components/ui/CdnImage.astro'
import { buttonVariants } from '@/components/ui/button'
import { getBandeDessineeByID } from '@/lib/api/cms'
import { getComicCoverURL } from '@/lib/comic'
import { getNoImageURL } from '@/lib/image'
import { convertJST } from '@/lib/time'
import { cn, parseURL } from '@/lib/utils'

// 自サイトの漫画へのカード
type Props = { link: string }

const { link } = Astro.props

const linkPath = parseURL(link)?.pathname ?? ''
const comicID = linkPath.split('/')[2]
const comic: bandeDessineeResult | null = comicID
  ? await getBandeDessineeByID(comicID).catch((e) => {
      // 取得できないのは、公開後に非公開・削除された場合とみなす（自サイトのコンテンツなので、存在しないものを指すことは基本的にない）。
      // 不完全なページ（lib/degraded.ts）としては記録せず、代わりの表示のまま通常どおりキャッシュさせる。再び公開されたときはタグのパージで消える
      console.error('[components/blocks/ComicCard.astro] Comic fetch error:', e)
      return null
    })
  : null

const coverURL = comic && getComicCoverURL(comic)
---

{
  comic && coverURL ? (
    <div class="max-w-2xl">
      <div class="bg-gray-300 h-full w-full px-4 py-2 rounded-md font-semibold">
        <div class="w-full flex flex-row space-x-4">
          <CdnImage
            src={coverURL}
            alt=""
            width={300}
            height={300}
            format="auto"
            class="w-1/3 h-56 object-contain rounded-sm bg-gray-400"
          />
          <div class="w-2/3 flex flex-col space-y-3">
            <div>
              <p class="text-xl text-wrap line-clamp-2">{comic.title_name}</p>
              <p class="text-gray-500 text-xs text-wrap line-clamp-2">{convertJST(comic.publishedAt)}</p>
            </div>
            <div class="font-medium text-sm">
              <p>ジャンル : {comic.tag.tag_name}</p>
              <p>シリーズ : {comic.series?.series_name || '-'}</p>
            </div>
            <div class="font-medium text-sm">
              <p class="text-wrap line-clamp-2">{comic.parsed_description[0]?.text}</p>
            </div>
            <div class="h-full flex flex-row items-end justify-end">
              <a
                href={linkPath}
                class={cn(buttonVariants(), 'w-full h-8 rounded-md flex items-center justify-center font-semibold')}
              >
                Read this
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="flex max-w-xl">
      <div class={cn(buttonVariants({ variant: 'outline' }), 'no-underline bg-gray-300 h-full w-full')}>
        <div class="w-full flex flex-row space-x-4">
          <CdnImage src={getNoImageURL()} alt="" width={300} height={300} class="max-w-36 h-auto" />
          <div class="w-full space-y-3 text-left">
            <div>
              <p class="text-xl text-wrap line-clamp-2">{cardNotFound.title}</p>
              <p class="text-gray-500 text-xs text-wrap line-clamp-2">0000/00/00 00:00:00 JST</p>
            </div>
            <div>
              <p>ジャンル : -</p>
              <p>シリーズ : -</p>
            </div>
            <div>
              <p>{cardNotFound.description}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}
