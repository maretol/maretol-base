---
// 引用画像の表示領域。取得するまでの表示（CiteImageFallback.astro）と取得後の表示（CiteImageContent.astro）で同じ箱を使い、
// island の差し替えで枠の大きさが変わらないようにする（リンクカードの LinkCardFrame.astro と同じ考え方）。
// 画像の寸法は取得するまで分からないので、箱は画像に合わせず 300×400（3:4）に固定し、画像は object-contain で中に収める
type Props = {
  // 中身が無いとき（取得前）に、画像の代わりとして読み上げる文言
  label?: string
}

const { label } = Astro.props
---

<div
  class="w-75 max-w-full aspect-3/4 bg-gray-300 shadow-xl flex items-center justify-center overflow-hidden"
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <slot />
</div>
