---
import CiteImageContent from './CiteImageContent.astro'
import CiteImageFallback from './CiteImageFallback.astro'
import { toBase64URL } from '@/lib/image'

// 外部サイトの画像の引用の枠。画像の取得と表示は Server Island（CiteImageContent.astro）に出し、
// 記事の HTML にはこの枠と、キャプション・引用元リンクだけを入れる（astro_design.md 決定 14）。
// 引用元の応答が遅くても記事の表示を待たせず、記事のキャッシュを引用元の状態から切り離す
type Props = {
  url: string
  source: string
  caption?: string
  sourceTitle?: string
  articleID: string
  draftKey?: string
}

const { url, source, caption, sourceTitle, articleID, draftKey } = Astro.props

// ページ内アンカーの id。モーダルの URL と 1 対 1 で対応する。
// island の外（この枠）に置くので、モーダルの URL から記事へ戻ったときの移動は island の差し替え前でも効く
const anchorID = toBase64URL(url)
const alt = caption || '引用画像'
---

{/* 枠は列の幅に合わせて縮むブロックにし、箱（CiteImageBox.astro。w-full）の幅は枠で決める。
    最大幅の 133（532px）は、箱の 500px に左右の p-3 と border-l-8 を足したもの。w-fit にすると箱が縮めず、狭い画面ではみ出す */}
<div class="bg-gray-200 p-3 rounded-lg border-l-8 border-l-gray-500 max-w-133" id={anchorID}>
  <CiteImageContent server:defer url={url} alt={alt} articleID={articleID} draftKey={draftKey}>
    <CiteImageFallback slot="fallback" alt={alt} />
  </CiteImageContent>
  <blockquote>
    <div class="mt-3 text-center">
      {caption && <p class="text-sm text-gray-800">{caption}</p>}
      <p class="text-sm text-gray-800">
        <a href={source} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
          {sourceTitle ? `引用元 : ${sourceTitle}` : '引用元'}
        </a>
      </p>
    </div>
  </blockquote>
</div>
