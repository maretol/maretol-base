---
import type { ParsedContent, TableOfContents as TOC } from 'api-types'
import AmazonLink from './AmazonLink.astro'
import ArtifactCard from './ArtifactCard.astro'
import BlogCard from './BlogCard.astro'
import Blockquote from './Blockquote.astro'
import CiteImage from './CiteImage.astro'
import ComicCard from './ComicCard.astro'
import ContentImage from './ContentImage.astro'
import GoogleMap from './GoogleMap.astro'
import Heading from './Heading.astro'
import IllustCard from './IllustCard.astro'
import LinkCard from './LinkCard.astro'
import MySiteCard from './MySiteCard.astro'
import NofetchLinkCard from './NofetchLinkCard.astro'
import Paragraph from './Paragraph.astro'
import TableOfContents from './TableOfContents.astro'
import Tweet from './Tweet.astro'
import YouTube from './YouTube.astro'

// parsed_content の 1 要素を、タグと p_option に応じたコンポーネントで描画する
type Props = {
  content: ParsedContent
  tableOfContents?: TOC
  // 画像モーダルの URL に使う
  articleID: string
  draftKey?: string
}

const { content, tableOfContents, articleID, draftKey } = Astro.props
const tag = content.tag_name
const html = content.inner_html || ''

// p はオプションで分岐する。ここに無いオプションは通常の段落として出す
const pOption = tag === 'p' ? (content.p_option ?? 'normal') : null
---

{
  /h[1-5]/.test(tag) ? (
    <Heading tag={tag} text={content.text} attrs={content.attributes} />
  ) : tag === 'hr' ? (
    <hr class="border-t-2 border-gray-300 my-8" />
  ) : tag === 'table' ? (
    html && (
      <div class="my-4 overflow-x-auto">
        <table lang="ja" set:html={html} />
      </div>
    )
  ) : tag === 'div' ? (
    html && <div class={content.attributes?.['class']} set:html={html} />
  ) : tag === 'ul' ? (
    <ul lang="ja" class="py-4" set:html={html} />
  ) : tag === 'ol' ? (
    <ol lang="ja" class="py-4" set:html={html} />
  ) : tag === 'blockquote' ? (
    <Blockquote innerHTML={html} text={content.text} />
  ) : tag !== 'p' ? (
    <div>
      <p>unknown tag error : {tag}</p>
      <div set:html={html} />
    </div>
  ) : pOption === 'image' || pOption === 'photo' ? (
    <div class="py-4">
      <ContentImage
        variant={pOption}
        src={content.text}
        subText={content.sub_texts ?? null}
        articleID={articleID}
        draftKey={draftKey}
      />
    </div>
  ) : pOption === 'cite_image' ? (
    // url と source が揃っていない引用画像は表示しない
    content.sub_texts?.url && content.sub_texts?.source && (
      <div class="py-4">
        <CiteImage
          url={content.sub_texts.url}
          source={content.sub_texts.source}
          caption={content.sub_texts.caption}
          sourceTitle={content.sub_texts.source_title}
          articleID={articleID}
          draftKey={draftKey}
        />
      </div>
    )
  ) : pOption === 'url' ? (
    <div class="py-4">
      <LinkCard link={content.text} />
    </div>
  ) : pOption === 'nofetch_url' ? (
    <div class="py-4">
      <NofetchLinkCard
        url={content.sub_texts?.url}
        title={content.sub_texts?.title}
        description={content.sub_texts?.description}
      />
    </div>
  ) : pOption === 'blog' ? (
    <div class="py-4">
      <BlogCard link={content.text} />
    </div>
  ) : pOption === 'illust_detail' ? (
    <div class="py-4">
      <IllustCard link={content.text} draftKey={draftKey} />
    </div>
  ) : pOption === 'comic' ? (
    <div class="py-4">
      <ComicCard link={content.text} />
    </div>
  ) : pOption === 'artifact' ? (
    <div class="py-4">
      <ArtifactCard link={content.text} />
    </div>
  ) : pOption === 'my_site' ? (
    <div class="py-4">
      <MySiteCard text={content.text} />
    </div>
  ) : pOption === 'youtube' ? (
    <YouTube videoURL={content.text} />
  ) : pOption === 'twitter' ? (
    <Tweet twitterURL={content.text} />
  ) : pOption === 'amazon' ? (
    <AmazonLink amazonURL={content.text} />
  ) : pOption === 'gmaps' ? (
    <GoogleMap subtexts={content.sub_texts} />
  ) : pOption === 'empty' || pOption === 'br' ? (
    <p class="leading-8 my-2">
      <br />
    </p>
  ) : pOption === 'table_of_contents' ? (
    tableOfContents && <TableOfContents toc={tableOfContents} />
  ) : pOption === 'block_start' || pOption === 'block_end' ? null : (
    <Paragraph innerHTML={content.inner_html || content.text} attrs={content.attributes} />
  )
}
