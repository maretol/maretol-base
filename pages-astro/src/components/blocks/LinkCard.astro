---
import LinkCardFrame from './LinkCardFrame.astro'
import { getOGPData } from '@/lib/api/ogp'
import { cacheLinkCard } from '@/lib/cache'

// リンク先の OGP を表示するカード。Server Island（server:defer）として使う（Block.astro）。
// 記事とは別のリクエストで描画されるので、リンク先の応答が遅くても記事の表示を待たせず、記事のキャッシュもリンク先の状態に左右されない
type Props = { link: string }

const { link } = Astro.props
const errorDescription = 'リンク先の情報取得でエラーが発生しました。リンクは機能しています'

// result が null なのは取得できなかったとき（リンク先のエラー・タイムアウト）
const result = await getOGPData(link)
// カードは記事とは別にエッジへキャッシュさせる。取得できなかったときは短く保持して、時間をおいて取り直す
cacheLinkCard(Astro.response, result !== null)

const errorTitle = 'Missing data fetching'
const title = result?.success ? result.og_title || 'No Page Title' : errorTitle
const { description, image, url, site, imageAlt } = result?.success
  ? {
      description: result.og_description,
      image: result.og_image || null,
      url: result.og_url || link,
      site: result.og_site_name || title,
      imageAlt: result.og_title,
    }
  : { description: errorDescription, image: null, url: link, site: errorTitle, imageAlt: errorTitle }
---

<LinkCardFrame
  link={link}
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  site={site}
  url={url}
/>
