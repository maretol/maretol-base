---
import BaseLayout, { type PageMeta } from './BaseLayout.astro'
import HeaderButtons from '@/components/shell/HeaderButtons.astro'
import FooterButtons from '@/components/shell/FooterButtons.astro'
import CdnImage from '@/components/ui/CdnImage.astro'
import { buttonVariants } from '@/components/ui/button'
import { getHeaderImageURL } from '@/lib/image'
import { cn } from '@/lib/utils'

// 幅が広い画面で左右に空白を作り、中央にコンテンツ、右にサイドバーを置く。ヘッダー画像とフッターもここで表示する
type Props = { meta?: PageMeta }

const { meta } = Astro.props
const year = new Date().getFullYear()
---

<BaseLayout meta={meta}>
  <div class="flex justify-center pb-10" id="top">
    <div class="max-w-425 w-full sm:mx-6">
      <div class="my-10">
        <div class="mb-2 pt-2">
          <a href="/" class={cn(buttonVariants({ variant: 'link' }), 'p-0')}>
            <CdnImage
              src={getHeaderImageURL()}
              width={400}
              height={100}
              class="w-125 object-contain"
              alt="Maretol Base"
              loading="eager"
            />
          </a>
        </div>
        <HeaderButtons />
      </div>
      <div class="md:flex md:flex-row">
        <div class="basis-4/5"><slot /></div>
        <div class="basis-1/5 ml-4 not-md:hidden">
          <slot name="sidebar" />
        </div>
      </div>
      <div class="my-10">
        <footer class="text-center text-sm text-gray-500 font-suse">
          <FooterButtons />
          <div>
            © 2024 - {year} Maretol
            <br />
            DO NOT REPOST WITHOUT PERMISSION
          </div>
        </footer>
      </div>
    </div>
  </div>
</BaseLayout>
