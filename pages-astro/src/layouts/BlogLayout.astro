---
import SiteLayout from './SiteLayout.astro'
import type { PageMeta } from './BaseLayout.astro'
import BlogSidebar from '@/components/shell/sidebar/BlogSidebar.astro'

// 中央にコンテンツ、右にサイドバーを置く。サイドバーは md 以上の幅でだけ表示する
type Props = {
  meta?: PageMeta
  // サイドバーを出さない場合は false（列は残る）。エラーページで、サイドバーのための取得を増やさないために使う
  sidebar?: boolean
}

const { meta, sidebar = true } = Astro.props
---

<SiteLayout meta={meta}>
  <div class="md:flex md:flex-row">
    <div class="basis-4/5"><slot /></div>
    <div class="basis-1/5 ml-4 not-md:hidden">
      {sidebar && <BlogSidebar />}
    </div>
  </div>
</SiteLayout>
