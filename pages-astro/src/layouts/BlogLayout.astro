---
import SiteLayout from './SiteLayout.astro'
import type { PageMeta } from './BaseLayout.astro'
import BlogSidebar from '@/components/shell/sidebar/BlogSidebar.astro'

// 中央にコンテンツ、右にサイドバーを置く。サイドバーは md 以上の幅でだけ表示する
type Props = {
  meta?: PageMeta
  // サイドバーを出さない場合は false（列は残る）。エラーページで、サイドバーのための取得を増やさないために使う
  sidebar?: boolean
}

const { meta, sidebar = true } = Astro.props
---

<SiteLayout meta={meta}>
  {/* 列の幅は grid で決める。本文は残りの幅、サイドバーは全体の 1/5（狭い画面では 15rem）。
      幅が中身やサイドバーの有無に左右されないので、読み込みの途中で本文の幅が変わらない（#1355） */}
  <div class="md:grid md:grid-cols-[minmax(0,4fr)_minmax(15rem,1fr)] md:gap-x-4">
    <div><slot /></div>
    <div class="not-md:hidden">
      {sidebar && <BlogSidebar />}
    </div>
  </div>
</SiteLayout>
