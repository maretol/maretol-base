---
import SiteLayout from './SiteLayout.astro'
import type { PageMeta } from './BaseLayout.astro'
import BlogSidebar from '@/components/shell/sidebar/BlogSidebar.astro'

// 中央にコンテンツ、右にサイドバーを置く。サイドバーは md 以上の幅でだけ表示する
type Props = {
  meta?: PageMeta
  // サイドバーを出さない場合は false（列は残る）。エラーページで、サイドバーのための取得を増やさないために使う
  sidebar?: boolean
}

const { meta, sidebar = true } = Astro.props
---

<SiteLayout meta={meta}>
  <div class="md:flex md:flex-row">
    {/* 2 つの列の幅は、合わせてちょうど 100% になるようにする（間隔は 16px）。
        80% と 20% のままだと合計が 16px あふれ、縮む量がサイドバーの有無で変わる。
        HTML の解析の途中でサイドバーが無い時点に描画されると、本文の幅が後から変わってずれる（#1355） */}
    <div class="basis-[calc(80%-12.8px)]"><slot /></div>
    <div class="basis-[calc(20%-3.2px)] ml-4 not-md:hidden">
      {sidebar && <BlogSidebar />}
    </div>
  </div>
</SiteLayout>
