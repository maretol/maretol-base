---
import '@/styles/global.css'
import { getDefaultOGPImageURL, getOGPImageURL } from '@/lib/image'
import { getHostname, SITE_DESCRIPTION, SITE_NAME, TWITTER_ACCOUNT } from '@/lib/site'

// html / head と body の外枠。ページごとの OGP はここへ props で渡す
export type PageMeta = {
  title?: string
  description?: string
  ogTitle?: string
  ogDescription?: string
  ogURL?: string
  // 変換済みの OGP 画像 URL
  ogImage?: string
  twitterCard?: 'summary' | 'summary_large_image'
  noindex?: boolean
}

type Props = { meta?: PageMeta }

const { meta = {} } = Astro.props
const title = meta.title ?? SITE_NAME
const description = meta.description ?? SITE_DESCRIPTION
const ogTitle = meta.ogTitle ?? SITE_NAME
const ogDescription = meta.ogDescription ?? `${SITE_DESCRIPTION} | トップページ`
const ogURL = meta.ogURL ?? getHostname()
const ogImage = meta.ogImage ?? getOGPImageURL(getDefaultOGPImageURL())
const twitterCard = meta.twitterCard ?? 'summary'
---

<!doctype html>
<html lang="ja" prefix="og: http://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content={TWITTER_ACCOUNT} />
    <meta name="twitter:creator" content={TWITTER_ACCOUNT} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body lang="ja" class="min-h-screen antialiased bg-gray-300 font-mplus1">
    <slot />
  </body>
</html>
