---
import { cacheTag } from 'cache-tags'
import BlogLayout from '@/layouts/BlogLayout.astro'
import type { PageMeta } from '@/layouts/BaseLayout.astro'
import Article from '@/components/article/Article.astro'
import Pagination from '@/components/ui/Pagination.astro'
import { getCMSContents } from '@/lib/api/cms'
import { cachePage } from '@/lib/cache'
import { getSampleEmbedTags } from '@/lib/content_tags'
import { getHrefWithoutPage, getTotalPage, isPageOutOfRange, PAGE_LIMIT, parsePageParam } from '@/lib/pagination'
import { getHostname, SITE_DESCRIPTION, SITE_NAME } from '@/lib/site'

// ブログの一覧
const pageNumber = parsePageParam(Astro.url.searchParams)
if (pageNumber === null) {
  // 不正な p と p=1 は、p を外した URL に統一する
  return Astro.redirect(getHrefWithoutPage('/blog', Astro.url.searchParams), 308)
}

const { contents, total } = await getCMSContents(Astro.locals, (pageNumber - 1) * PAGE_LIMIT, PAGE_LIMIT)
if (isPageOutOfRange(pageNumber, total, PAGE_LIMIT)) {
  // 記事が増えてこのページが存在するようになったら、404 のキャッシュも一緒に消えるようにする
  Astro.locals.notFound = { tags: [cacheTag.blogList] }
  return Astro.rewrite('/404')
}

cachePage(Astro.response, getSampleEmbedTags(contents), { sidebar: true })

const title = `Blog | ${SITE_NAME}`
const description = `${SITE_DESCRIPTION} | ブログ`
const meta: PageMeta = {
  title,
  description,
  ogTitle: title,
  ogDescription: description,
  ogURL: `${getHostname()}/blog`,
}
---

<BlogLayout meta={meta}>
  <div class="flex flex-col justify-center gap-10">
    {
      contents.map((content) => (
        <Article
          id={content.id}
          title={content.title}
          updatedAt={content.updatedAt}
          categories={content.categories}
          parsedContents={content.parsed_content}
        />
      ))
    }
    <div class="flex justify-center">
      <Pagination path="/blog" currentPage={pageNumber} totalPage={getTotalPage(total, PAGE_LIMIT)} />
    </div>
  </div>
</BlogLayout>
