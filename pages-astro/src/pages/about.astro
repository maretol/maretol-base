---
import SiteLayout from '@/layouts/SiteLayout.astro'
import InfoArticle from '@/components/article/InfoArticle.astro'
import { loadInfoPage } from '@/lib/info_page'

// このサイトについて（CMS の info の /about）
const PATH = '/about'

const page = await loadInfoPage(Astro, { path: PATH, metaTitle: 'このサイトについて', description: 'このサイトについて' })
if (page instanceof Response) {
  return page
}
---

<SiteLayout meta={page.meta} class="min-w-0">
  <InfoArticle info={page.info} title="このサイトについて" path={PATH} articleID="about" />
</SiteLayout>
