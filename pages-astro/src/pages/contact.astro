---
import SiteLayout from '@/layouts/SiteLayout.astro'
import InfoArticle from '@/components/article/InfoArticle.astro'
import { loadInfoPage } from '@/lib/info_page'

// 連絡先（CMS の info の /contact）
const PATH = '/contact'

const page = await loadInfoPage(Astro, { path: PATH, metaTitle: '連絡先', description: '連絡先ページ' })
if (page instanceof Response) {
  return page
}
---

<SiteLayout meta={page.meta} class="min-w-0">
  <InfoArticle info={page.info} title="連絡先" path={PATH} articleID="contact" />
</SiteLayout>
