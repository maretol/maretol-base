---
import { cacheTag } from 'cache-tags'
import SiteLayout from '@/layouts/SiteLayout.astro'
import type { PageMeta } from '@/layouts/BaseLayout.astro'
import InfoArticle from '@/components/article/InfoArticle.astro'
import { getInfoPage } from '@/lib/api/cms'
import { cachePage } from '@/lib/cache'
import { getEmbedTags } from '@/lib/content_tags'
import { getHostname, SITE_NAME } from '@/lib/site'

// Secret（CMS の info の /secret）。検索結果には出さない
const PATH = '/secret'

const info = await getInfoPage(Astro.locals, PATH)
if (!info) {
  // info が公開されたときに、404 のキャッシュも一緒に消えるようにする
  Astro.locals.notFound = { tags: [cacheTag.info] }
  return Astro.rewrite('/404')
}

cachePage(Astro.response, [cacheTag.info, ...getEmbedTags(info.parsed_content)])

const title = `Secret | ${SITE_NAME}`
const meta: PageMeta = {
  title,
  description: 'Secret',
  ogTitle: title,
  ogDescription: 'Secret',
  ogURL: `${getHostname()}${PATH}`,
  noindex: true,
}
---

<SiteLayout meta={meta} class="min-w-0">
  <InfoArticle info={info} title="Secret" path={PATH} articleID="secret" />
</SiteLayout>
