---
import SiteLayout from '@/layouts/SiteLayout.astro'
import InfoArticle from '@/components/article/InfoArticle.astro'
import { loadInfoPage } from '@/lib/info_page'

// Secret（CMS の info の /secret）。検索結果には出さない
const PATH = '/secret'

const page = await loadInfoPage(Astro, { path: PATH, metaTitle: 'Secret', description: 'Secret', noindex: true })
if (page instanceof Response) {
  return page
}
---

<SiteLayout meta={page.meta} class="min-w-0">
  <InfoArticle info={page.info} title="Secret" path={PATH} articleID="secret" />
</SiteLayout>
