---
import { HouseIcon } from '@lucide/astro'
import BlogLayout from '@/layouts/BlogLayout.astro'
import Tags from '@/components/article/Tags.astro'
import { buttonVariants } from '@/components/ui/button'
import { card } from '@/components/ui/card'
import { noStore } from '@/lib/cache'
import { createEvent, describeError, recordLogEvent } from '@/lib/log'
import { convertJST } from '@/lib/time'
import { cn } from '@/lib/utils'

// ページの描画中に例外が起きたときに表示する（データ取得の失敗など）。キャッシュはしない
// Astro がページの frontmatter の例外を受けてこのページを描くときは error を受け取る（本文の描画中の例外やミドルウェアの例外は
// src/mw/cache.ts と src/worker.ts が /500 へ rewrite するので error は無く、それぞれが記録する）
type Props = { error?: unknown }

const { error } = Astro.props
if (error !== undefined) {
  recordLogEvent(Astro.locals, createEvent('render_error', { stage: 'page', ...describeError(error) }))
}

noStore(Astro.response)
// /500 を直接開いた場合も 500 で返す
Astro.response.status = 500
---

<BlogLayout meta={{ noindex: true }} sidebar={false}>
  <div class={cn(card.root, 'w-full bg-gray-100')}>
    <div class={card.header}>
      <h3 class={card.title}>500 Internal Server Error</h3>
      <p class={card.description}>現在時刻{convertJST(new Date().toISOString())}</p>
      <div class={cn(card.content, 'pl-0 pt-2 pb-0')}>
        <Tags tags={[]} />
      </div>
    </div>
    <div class={card.content}>
      <div class="space-y-5 content">
        <p>ページの表示中にエラーが発生しました。時間をおいて再度アクセスしてください。</p>
      </div>
    </div>
    <div class={card.footer}>
      <div class="flex justify-center mt-2 w-full">
        <a href="/" class={cn(buttonVariants({ variant: 'secondary' }), 'w-96 flex justify-center items-end gap-1')}>
          <HouseIcon />
          <h2>Home</h2>
        </a>
      </div>
    </div>
  </div>
</BlogLayout>
