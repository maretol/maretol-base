---
import BlogLayout from '@/layouts/BlogLayout.astro'
import InfoArticle from '@/components/article/InfoArticle.astro'
import { loadInfoPage } from '@/lib/info_page'

// 制作物 Post for nostter の紹介（CMS の info の /artifacts/post-for-nostter）。サイドバーを出す
const PATH = '/artifacts/post-for-nostter'

const page = await loadInfoPage(Astro, { path: PATH, metaTitle: 'Post for nostter', description: 'about Post for nostter', sidebar: true })
if (page instanceof Response) {
  return page
}
---

<BlogLayout meta={page.meta}>
  <InfoArticle info={page.info} title="Post for nostter" path={PATH} articleID="post-for-nostter" />
</BlogLayout>
